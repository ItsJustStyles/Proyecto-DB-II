# Base de datos (PostgreSQL)
DB_USER=MediCitas
DB_PASSWORD=MediCitas123
DB_NAME=MediCitas
DB_POOL_MAX=20
MAX_RETRIES=3

# Caché y Agenda (Redis)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
SLOT_STEP_MIN=15

# Identidad Delegada (Keycloak / OIDC)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=medicitas
KEYCLOAK_CLIENT_ID=medicitas-api
KEYCLOAK_PUBLIC_URL=http://localhost:8080

OIDC_ISSUER=http://localhost:8080/realms/medicitas
OIDC_JWKS_URL=http://keycloak:8080/realms/medicitas/protocol/openid-connect/certs
OIDC_CLIENT_ID=medicitas-api